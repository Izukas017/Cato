<Window x:Class="Cato.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cato" Width="760" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Icon="Assets/cato.ico">

    <Grid x:Name="Root" VerticalAlignment="Top" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="RootMove"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- "Orejas" cóncavas que funden el notch con el borde superior -->
        <Grid x:Name="EarL" Grid.Column="0" VerticalAlignment="Top">
            <Path x:Name="EarLFill" Fill="{StaticResource NotchBg}" Data="M0,0 L16,0 L16,16 A16,16 0 0 0 0,0 Z"/>
        </Grid>
        <Grid x:Name="EarR" Grid.Column="2" VerticalAlignment="Top">
            <Path x:Name="EarRFill" Fill="{StaticResource NotchBg}" Data="M16,0 L0,0 L0,16 A16,16 0 0 1 16,0 Z"/>
        </Grid>

        <Border x:Name="Notch" Grid.Column="1" Width="200" Height="38"
                Background="{StaticResource NotchBg}" CornerRadius="0,0,18,18"
                AllowDrop="True" MouseEnter="Notch_MouseEnter" MouseLeave="Notch_MouseLeave" MouseLeftButtonUp="Notch_Click"
                DragEnter="Notch_DragEnter" DragLeave="Notch_DragLeave" Drop="Notch_Drop" ClipToBounds="True">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Configuración" Click="Settings_Click"/>
                    <MenuItem Header="Salir de Cato" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <!-- Fundido de color: brillo inferior bajo todas las vistas -->
                <Border x:Name="Glow" IsHitTestVisible="False" Opacity="0" CornerRadius="0,0,18,18">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.2"/>
                            <GradientStop Color="#66000000" Offset="0.65"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <!-- ===== Cerrado: anillo · hora · onda ===== -->
                <Grid x:Name="ClosedView" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                        <Ellipse Stroke="#33FFFFFF" StrokeThickness="3"/>
                        <Path x:Name="Ring" Stroke="{StaticResource Green}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <TextBlock x:Name="Clock" Grid.Column="1" Foreground="White" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <DockPanel x:Name="OverlayPanel" Grid.Column="1" Visibility="Collapsed" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="OverlayIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OverlayPct" DockPanel.Dock="Right" Foreground="White" FontSize="11" Width="30" TextAlignment="Right" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="OverlayBar" Style="{StaticResource Thin}" Height="5" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel x:Name="Wave" Grid.Column="2" Orientation="Horizontal" Height="18" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="White"/>
                        <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="White"/>
                        <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="White"/>
                        <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="White"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Alerta compacta (carga, auriculares, recordatorios) ===== -->
                <Grid x:Name="AlertView" Visibility="Collapsed" Margin="14,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                        <Ellipse x:Name="AlertIconBg" Fill="{StaticResource Green}"/>
                        <TextBlock x:Name="AlertIcon" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="AlertImage" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip><RectangleGeometry Rect="0,0,34,34" RadiusX="9" RadiusY="9"/></Image.Clip>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AlertTitle" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AlertSub" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="AlertValue" Grid.Column="2" Foreground="White" FontSize="24" VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Abierto: cabecera + carrusel de páginas ===== -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="18,9,18,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PageTitle" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="34,0,0,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="12" Height="12" Margin="0,0,8,0">
                                <Ellipse Stroke="#33FFFFFF" StrokeThickness="2"/>
                                <Path x:Name="HeaderRing" Stroke="{StaticResource Green}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <TextBlock x:Name="HeaderDate" Foreground="White" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock x:Name="HeaderTime" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0">
                        <Button Style="{StaticResource IconBtn}" Content="&#xE713;" FontSize="11" Padding="4" Margin="0,0,8,0" Click="Settings_Click" ToolTip="Configuración"/>
                        <StackPanel x:Name="HeaderWave" Orientation="Horizontal" Height="14" VerticalAlignment="Center">
                            <Rectangle Width="2.5" Height="14" RadiusX="1.2" RadiusY="1.2" Margin="1,0" Fill="White"/>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.2" RadiusY="1.2" Margin="1,0" Fill="White"/>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.2" RadiusY="1.2" Margin="1,0" Fill="White"/>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.2" RadiusY="1.2" Margin="1,0" Fill="White"/>
                        </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Circle}" Content="&#xE76B;" Click="PrevPage_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource Circle}" Content="&#xE76C;" Click="NextPage_Click"/>
                        <Grid x:Name="Pages" Grid.Column="1" Margin="12,0" ClipToBounds="True">

                            <!-- Música: portada a la izquierda, todo lo demás a su derecha -->
                            <Grid x:Name="PageMusic" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ArtBox" Width="78" Height="78" CornerRadius="13" Background="#26FFFFFF" VerticalAlignment="Center">
                                    <TextBlock x:Name="ArtGlyph" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaTitle" Text="Nada sonando" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MediaArtist" Style="{StaticResource Small}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Elapsed" Foreground="White" FontSize="12" Text="0:00" MinWidth="34"/>
                                        <ProgressBar x:Name="MediaProgress" Grid.Column="1" Style="{StaticResource Thin}" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBlock x:Name="Remaining" Grid.Column="2" Style="{StaticResource Small}" FontSize="12" Text="-0:00" MinWidth="38" TextAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,1,0,0">
                                        <Button Style="{StaticResource IconBtn}" Padding="6" Content="&#xE8BD;" HorizontalAlignment="Left" Margin="-7,0,0,0" Click="Lyrics_Click" ToolTip="Letra"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconBtn}" Padding="6" Content="&#xE892;" FontSize="16" Click="Prev_Click"/>
                                            <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Padding="6" Content="&#xE768;" FontSize="18" Margin="10,0" Click="Play_Click"/>
                                            <Button Style="{StaticResource IconBtn}" Padding="6" Content="&#xE893;" FontSize="16" Click="Next_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

<!-- Pomodoro -->
                            <Grid x:Name="PagePomo" Visibility="Collapsed" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PomoPhase" Style="{StaticResource Small}"/>
                                    <TextBlock x:Name="TimerText" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PomoEnd" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="  hasta terminar" Foreground="{StaticResource Purple}" FontSize="12"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PomoPhaseBar" Style="{StaticResource Thin}" Foreground="{StaticResource Purple}" Margin="0,6,24,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <TextBlock Text="Esta ronda" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="StartBtn" Click="StartPause_Click" Background="#E6FFFFFF" Foreground="Black" FontWeight="SemiBold" Padding="12,3"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" FontSize="11" Click="Reset_Click" ToolTip="Reiniciar"/>
                                        </StackPanel>
                                    </Grid>
                                    <Canvas x:Name="RoundTrack" Height="32" Margin="0,8,0,0" SizeChanged="RoundTrack_SizeChanged"/>
                                    <TextBlock x:Name="PomoTotal" Style="{StaticResource Small}" FontSize="10"/>
                                </StackPanel>
                            </Grid>

                            <!-- Día y tiempo -->
                            <Grid x:Name="PageDay" Visibility="Collapsed" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="WeatherGlyph" FontFamily="Segoe UI Symbol" FontSize="21" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="WeatherTemp" Foreground="White" FontSize="25" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="WeatherDesc" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="WeatherMeta" Style="{StaticResource Small}" FontSize="10" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock x:Name="DayPhase" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock x:Name="DayNext" Foreground="{StaticResource Blue}" FontSize="12" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="DayBar" Style="{StaticResource Thin}" Foreground="{StaticResource Blue}" Margin="0,5,14,0"/>
                                </StackPanel>
                                <Canvas x:Name="SunArc" Grid.Column="1" Height="84" SizeChanged="SunArc_SizeChanged"/>
                            </Grid>

                            <!-- Agua -->
                            <Grid x:Name="PageWater" Visibility="Collapsed" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="WaterAmount" Foreground="White" FontSize="25" FontWeight="Bold"/>
                                            <TextBlock x:Name="WaterGoalText" Style="{StaticResource Small}" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                                        </StackPanel>
                                        <CheckBox x:Name="WaterRemind" Style="{StaticResource Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="WaterRemind_Click" ToolTip="Recordatorios cada hora"/>
                                    </Grid>
                                    <TextBlock x:Name="WaterStatus" Style="{StaticResource Small}"/>
                                    <ProgressBar x:Name="WaterBar" Style="{StaticResource Thin}" Foreground="{StaticResource Blue}" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Background="{StaticResource Blue}" Padding="10,2" Click="Drink_Click" Content="💧 Beber 250 ml"/>
                                        <Button Click="WaterGoal_Click" Padding="10,2" Content="Meta" ToolTip="Cambiar meta diaria"/>
                                    </StackPanel>
                                </StackPanel>
                                <Canvas x:Name="WaterChart" Grid.Column="1" Height="84" SizeChanged="WaterChart_SizeChanged"/>
                            </Grid>

                            <!-- Bandeja -->
                            <Grid x:Name="PageShelf" Visibility="Collapsed">
                                <Rectangle x:Name="DropRect" Stroke="#40FFFFFF" StrokeDashArray="4 3" RadiusX="12" RadiusY="12" Fill="Transparent"/>
                                <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DropText" Text="Suelta archivos aquí" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Arrástralos fuera cuando quieras · clic para abrir" Style="{StaticResource Small}" FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <ListBox x:Name="ShelfList" ItemsPanel="{StaticResource Row}" Visibility="Collapsed"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="ShelfList_Down" PreviewMouseMove="ShelfList_Move" PreviewMouseLeftButtonUp="ShelfList_Up">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="78" Margin="2,4">
                                                <Image Source="{Binding Icon}" Width="40" Height="40"/>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding SizeText}" Foreground="#8CFFFFFF" FontSize="10" TextAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="ClearShelfBtn" Content="Vaciar" Click="ClearShelf_Click" Padding="8,1" FontSize="10" Margin="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Portapapeles -->
                            <Grid x:Name="PageClip" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="ClipList" ItemsPanel="{StaticResource Row}" PreviewMouseLeftButtonUp="ClipList_Click"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="94" Height="66" CornerRadius="10" Background="#17FFFFFF" Padding="8,6" BorderThickness="1" BorderBrush="{Binding Border}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Preview}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding Age}" Foreground="#8CFFFFFF" FontSize="9"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="ClipEmpty" Text="Copia texto y aparecerá aquí" Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ClipCount" Grid.Row="1" Style="{StaticResource Small}" FontSize="10" Margin="2,2,0,0"/>
                            </Grid>

                            <!-- Tareas -->
                            <Grid x:Name="PageTodo" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TodoCount" Foreground="White" FontSize="27" FontWeight="Bold"/>
                                    <TextBlock Text="Tareas hechas hoy" Style="{StaticResource Small}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Click="AddTask_Click" Padding="10,2" Content="+ Añadir"/>
                                        <Button x:Name="EditTasksBtn" Click="EditTasks_Click" Padding="10,2" Content="Editar"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="TaskInput" Visibility="Collapsed" Background="#1FFFFFFF" Foreground="White" CaretBrush="White"
                                             BorderThickness="0" Padding="8,4" Margin="0,0,0,4" FontSize="12" KeyDown="TaskInput_KeyDown"
                                             ToolTip="Escribe la tarea y pulsa Intro. Añade @18:30 para un recordatorio."/>
                                    <ListBox x:Name="TodoList" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="TodoList_Click">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Bg}" CornerRadius="8" Padding="8,4" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="0,0,0,2">
                                                    <DockPanel>
                                                        <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0">
                                                            <Ellipse Fill="{Binding CheckFill}" Stroke="#8CFFFFFF" StrokeThickness="{Binding CheckStroke}"/>
                                                            <TextBlock Text="{Binding CheckGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Button DockPanel.Dock="Right" Visibility="{Binding DelVis}" Tag="{Binding Item}" Click="DeleteTask_Click"
                                                                Style="{StaticResource IconBtn}" Content="&#xE74D;" FontSize="10" Padding="3" Margin="0"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="#8CFFFFFF" FontSize="10" VerticalAlignment="Center" Margin="6,0"/>
                                                        <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" TextDecorations="{Binding Deco}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <!-- Terminal: PowerShell dentro del notch; hereda los permisos de Cato -->
                            <Grid x:Name="PageTerm" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="TermOut" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" Background="#17FFFFFF"
                                         Foreground="White" BorderThickness="0" Padding="8,4" Margin="0,0,0,4" FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                                <Grid Grid.Row="1" Background="#1FFFFFFF">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TermPrompt" Foreground="#8CFFFFFF" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="TermIn" Grid.Column="1" Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="6,4"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="11" KeyDown="TermIn_KeyDown" PreviewMouseDown="TermIn_Focus"
                                             ToolTip="Intro ejecuta · Esc cancela · ↑↓ historial"/>
                                </Grid>
                            </Grid>

                            <!-- Claude: qué está haciendo ahora mismo (alimentado por los hooks de Claude Code) -->
                            <Grid x:Name="PageAct" Visibility="Collapsed">
                                <!-- una sesión: detalle y últimas acciones -->
                                <Grid x:Name="ActSingle">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ActDot" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ActAction" Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="235"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ActNow" Style="{StaticResource Small}" Foreground="#CCFFFFFF" TextWrapping="Wrap" MaxHeight="64" LineHeight="15"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="ActState" Style="{StaticResource Small}" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ActList" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <!-- varias sesiones: una fila por sesión -->
                                <StackPanel x:Name="ActMulti" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Widgets -->
                            <Grid x:Name="PageWidgets" Visibility="Collapsed" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Card}" CornerRadius="12" Padding="10,5" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="ESTA SEMANA" Style="{StaticResource Small}" FontSize="9" FontWeight="Bold"/>
                                        <Grid x:Name="WeekGrid" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="WeekTasks" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="WeekNext" Style="{StaticResource Small}" FontSize="10" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="12" Padding="10,5" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="SysLabel" Style="{StaticResource Small}" FontSize="9" FontWeight="Bold"/>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="44" Height="44">
                                                <Ellipse Stroke="#33FFFFFF" StrokeThickness="4"/>
                                                <Path x:Name="SysRing" Stroke="{StaticResource Green}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <TextBlock x:Name="SysIcon" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="SysValue" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                                <TextBlock x:Name="SysState" Foreground="{StaticResource Green}" FontSize="11"/>
                                                <TextBlock x:Name="SysSub" Style="{StaticResource Small}" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>

                <!-- ===== Modo juego: fina, ancho según los datos, semitransparente ===== -->
                <Grid x:Name="GameView" Visibility="Collapsed">
                    <StackPanel x:Name="GameRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.8" Color="Black"/>
                        </StackPanel.Effect>
                        <TextBlock x:Name="GameClock" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <StackPanel x:Name="GFpsBox" Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock Text="FPS" Foreground="{StaticResource Dim}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GFps" Foreground="{StaticResource Green}" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="GCpuBox" Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock Text="CPU" Foreground="{StaticResource Dim}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GCpu" Foreground="White" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="GGpuBox" Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock Text="GPU" Foreground="{StaticResource Dim}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GGpu" Foreground="White" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="GRamBox" Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock Text="RAM" Foreground="{StaticResource Dim}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GRam" Foreground="White" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="GVramBox" Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock Text="VRAM" Foreground="{StaticResource Dim}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GVram" Foreground="White" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Modo letra: más ancho, ilumina cada verso ===== -->
                <Grid x:Name="LyricsView" Visibility="Collapsed">
                    <Grid Margin="20,8,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LyrArtBox" Width="50" Height="50" CornerRadius="10" Background="#26FFFFFF">
                                    <TextBlock x:Name="LyrArtGlyph" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LyrTitle" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="LyrArtist" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LyrElapsed" Foreground="White" FontSize="11"/>
                                <ProgressBar x:Name="LyrProgress" Grid.Column="1" Style="{StaticResource Thin}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LyrRemaining" Grid.Column="2" Style="{StaticResource Small}" TextAlignment="Right"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="-4,4,0,0">
                                <Button Style="{StaticResource IconBtn}" Padding="5" Content="&#xE8BD;" Background="#33FFFFFF" Click="Lyrics_Click" ToolTip="Cerrar letra"/>
                                <Button Style="{StaticResource IconBtn}" Padding="5" Content="&#xE892;" Click="Prev_Click" Margin="22,0,2,0"/>
                                <Button x:Name="PlayBtn2" Style="{StaticResource IconBtn}" Padding="5" Content="&#xE768;" Click="Play_Click"/>
                                <Button Style="{StaticResource IconBtn}" Padding="5" Content="&#xE893;" Click="Next_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#26FFFFFF" Padding="18,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LyrPrev" Foreground="{StaticResource Faint}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LyrCur" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="LyrNext" Foreground="{StaticResource Faint}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
